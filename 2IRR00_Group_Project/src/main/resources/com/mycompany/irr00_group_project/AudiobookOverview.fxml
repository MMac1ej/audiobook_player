<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.irr00_group_project.gui.AudiobookOverview"
      stylesheets="@AudiobookOverview.css">
    <children>
        <HBox styleClass="search-holder">
            <children>
                <Button fx:id="backButton" text="← Back" onAction="#handleBack"
                        styleClass="back-button"/>
                <TextField fx:id="searchBar" promptText="Search your preferred audiobook"
                           onAction="#handleSearch" HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#handleReset" styleClass="clear-button"/>
                <Button text="Search" onAction="#handleSearch" styleClass="search-button"/>
                <Button text="See all" onAction="#handleReset" styleClass="search-button"/>
            </children>
        </HBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="bookHolder" styleClass="book-holder"/>
            </content>
        </ScrollPane>
    </children>
</VBox>
