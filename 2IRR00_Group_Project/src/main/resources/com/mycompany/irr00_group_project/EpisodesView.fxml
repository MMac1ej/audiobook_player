<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.irr00_group_project.gui.EpisodesViewController">
   <children>
      <VBox prefWidth="600.0" HBox.hgrow="ALWAYS" styleClass="episodes-root">
         <children>
            <Button fx:id="backButton" text="← Back" onAction="#handleBack"
                    styleClass="episodes-back-btn"/>
            <ListView fx:id="listView" onMouseClicked="#handleMouseClicked"
                      prefWidth="555.0" VBox.vgrow="ALWAYS" styleClass="episodes-list"/>
         </children>
      </VBox>
   </children>
</HBox>
