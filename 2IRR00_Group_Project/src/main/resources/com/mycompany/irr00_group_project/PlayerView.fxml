<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: #f0f2f5;"
      stylesheets="@player-light.css"
      spacing="0" minWidth="480">
    <padding>
        <Insets top="20" right="40" bottom="28" left="40"/>
    </padding>
    <fx:define>
        <ToggleGroup fx:id="speedGroup"/>
    </fx:define>

    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT">
        <Button fx:id="backButton" text="&#8592; Back" styleClass="player-back-btn"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Episode title card -->
    <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);"
          spacing="10">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <Label text="NOW PLAYING"
               style="-fx-text-fill: #5c6bc0; -fx-font-size: 11px; -fx-font-weight: bold;"
               maxWidth="Infinity" alignment="CENTER"/>

        <Label fx:id="episodeTitleLabel" text="No episode loaded"
               style="-fx-text-fill: #1a1a2e; -fx-font-size: 20px; -fx-font-weight: bold;
                      -fx-wrap-text: true; -fx-text-alignment: center;"
               maxWidth="Infinity" alignment="CENTER"/>

        <Region prefHeight="8"/>

        <Slider fx:id="seekSlider" min="0" max="1" value="0"
                style="-fx-accent: #5c6bc0;" maxWidth="Infinity"/>

        <HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="timeLabel" text="0:00 / 0:00"
                   style="-fx-text-fill: #9e9e9e; -fx-font-size: 12px;"/>
        </HBox>

        <Region prefHeight="4"/>

        <!-- Playback controls -->
        <HBox alignment="CENTER" spacing="16">
            <Button fx:id="prevButton" text="&#9664;&#9664;" styleClass="player-ctrl-round"/>
            <Button fx:id="playPauseButton" text="Play"   styleClass="player-play-btn"/>
            <Button fx:id="stopButton"     text="&#9632;" styleClass="player-ctrl-round"/>
            <Button fx:id="nextButton"     text="&#9654;&#9654;" styleClass="player-ctrl-round"/>
        </HBox>

    </VBox>

    <Region prefHeight="16"/>

    <!-- Speed + Volume card -->
    <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);"
          spacing="14">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Speed" style="-fx-text-fill: #757575; -fx-font-size: 13px;" minWidth="52"/>
            <ToggleButton fx:id="speed05Button" text="0.5x" toggleGroup="$speedGroup" styleClass="player-speed-btn"/>
            <ToggleButton fx:id="speed10Button" text="1.0x" toggleGroup="$speedGroup" styleClass="player-speed-btn" selected="true"/>
            <ToggleButton fx:id="speed15Button" text="1.5x" toggleGroup="$speedGroup" styleClass="player-speed-btn"/>
            <ToggleButton fx:id="speed20Button" text="2.0x" toggleGroup="$speedGroup" styleClass="player-speed-btn"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Volume" style="-fx-text-fill: #757575; -fx-font-size: 13px;" minWidth="52"/>
            <Label text="0%"   style="-fx-text-fill: #bdbdbd; -fx-font-size: 11px;"/>
            <Slider fx:id="volumeSlider" min="0" max="1" value="1"
                    style="-fx-accent: #5c6bc0;"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Label text="100%" style="-fx-text-fill: #bdbdbd; -fx-font-size: 11px;"/>
        </HBox>

    </VBox>

    <Region prefHeight="16"/>

    <!-- Sleep timer card -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
        <padding>
            <Insets top="14" right="24" bottom="14" left="24"/>
        </padding>
        <Label text="Sleep timer" style="-fx-text-fill: #757575; -fx-font-size: 13px;"/>
        <Spinner fx:id="sleepSpinner" prefWidth="66" editable="false" style="-fx-font-size: 13px;">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="120" initialValue="15"/>
            </valueFactory>
        </Spinner>
        <Label text="min" style="-fx-text-fill: #757575; -fx-font-size: 13px;"/>
        <Button fx:id="sleepToggleButton" text="Start" styleClass="player-sleep-btn"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="sleepCounterLabel" text=""
               style="-fx-text-fill: #5c6bc0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

</VBox>
