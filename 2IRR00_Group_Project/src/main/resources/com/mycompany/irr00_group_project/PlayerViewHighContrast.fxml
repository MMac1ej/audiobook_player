<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: #000000;"
      spacing="0" minWidth="480">
    <padding>
        <Insets top="20" right="40" bottom="28" left="40"/>
    </padding>
    <fx:define>
        <ToggleGroup fx:id="speedGroup"/>
    </fx:define>

    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="0">
        <Button fx:id="backButton" text="&#8592; Back"
                style="-fx-background-color: transparent; -fx-text-fill: #FFFF00;
                       -fx-font-size: 13px; -fx-cursor: hand; -fx-font-weight: bold;
                       -fx-padding: 4 12 4 0; -fx-border-color: transparent;"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Episode title section -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="NOW PLAYING"
               style="-fx-text-fill: #FFFF00; -fx-font-size: 11px; -fx-font-weight: bold;"
               maxWidth="Infinity" alignment="CENTER"/>
        <Label fx:id="episodeTitleLabel" text="No episode loaded"
               style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;
                      -fx-wrap-text: true; -fx-text-alignment: center;"
               maxWidth="Infinity" alignment="CENTER"/>
    </VBox>

    <Region prefHeight="36"/>

    <!-- Progress bar -->
    <VBox spacing="6">
        <Slider fx:id="seekSlider" min="0" max="1" value="0"
                style="-fx-accent: #FFFF00;"
                maxWidth="Infinity"/>
        <HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="timeLabel" text="0:00 / 0:00"
                   style="-fx-text-fill: #CCCCCC; -fx-font-size: 12px;"/>
        </HBox>
    </VBox>

    <Region prefHeight="28"/>

    <!-- Main playback controls -->
    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="prevButton" text="&#9664;&#9664;"
                style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF;
                       -fx-font-size: 17px; -fx-cursor: hand;
                       -fx-padding: 8 14; -fx-border-color: transparent;"/>
        <Button fx:id="playPauseButton" text="Play"
                style="-fx-background-color: #FFFF00; -fx-text-fill: #000000;
                       -fx-font-size: 15px; -fx-font-weight: bold;
                       -fx-background-radius: 50%;
                       -fx-min-width: 64px; -fx-min-height: 64px;
                       -fx-max-width: 64px; -fx-max-height: 64px;
                       -fx-cursor: hand;"/>
        <Button fx:id="stopButton" text="&#9632;"
                style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF;
                       -fx-font-size: 17px; -fx-cursor: hand;
                       -fx-padding: 8 14; -fx-border-color: transparent;"/>
        <Button fx:id="nextButton" text="&#9654;&#9654;"
                style="-fx-background-color: transparent; -fx-text-fill: #FFFFFF;
                       -fx-font-size: 17px; -fx-cursor: hand;
                       -fx-padding: 8 14; -fx-border-color: transparent;"/>
    </HBox>

    <Region prefHeight="32"/>

    <!-- Speed + Volume card -->
    <VBox style="-fx-background-color: #111111; -fx-background-radius: 14;
                 -fx-border-color: #FFFFFF; -fx-border-radius: 14; -fx-border-width: 1;"
          spacing="16">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <!-- Speed -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Speed" style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px;"
                   minWidth="52"/>
            <ToggleButton fx:id="speed05Button" text="0.5x" toggleGroup="$speedGroup"
                          style="-fx-background-color: #1A1A1A; -fx-text-fill: #FFFFFF;
                                 -fx-background-radius: 20; -fx-padding: 5 14;
                                 -fx-font-size: 12px; -fx-cursor: hand;
                                 -fx-border-color: #FFFFFF; -fx-border-width: 1;
                                 -fx-border-radius: 20;"/>
            <ToggleButton fx:id="speed10Button" text="1.0x" toggleGroup="$speedGroup" selected="true"
                          style="-fx-background-color: #1A1A1A; -fx-text-fill: #FFFFFF;
                                 -fx-background-radius: 20; -fx-padding: 5 14;
                                 -fx-font-size: 12px; -fx-cursor: hand;
                                 -fx-border-color: #FFFFFF; -fx-border-width: 1;
                                 -fx-border-radius: 20;"/>
            <ToggleButton fx:id="speed15Button" text="1.5x" toggleGroup="$speedGroup"
                          style="-fx-background-color: #1A1A1A; -fx-text-fill: #FFFFFF;
                                 -fx-background-radius: 20; -fx-padding: 5 14;
                                 -fx-font-size: 12px; -fx-cursor: hand;
                                 -fx-border-color: #FFFFFF; -fx-border-width: 1;
                                 -fx-border-radius: 20;"/>
            <ToggleButton fx:id="speed20Button" text="2.0x" toggleGroup="$speedGroup"
                          style="-fx-background-color: #1A1A1A; -fx-text-fill: #FFFFFF;
                                 -fx-background-radius: 20; -fx-padding: 5 14;
                                 -fx-font-size: 12px; -fx-cursor: hand;
                                 -fx-border-color: #FFFFFF; -fx-border-width: 1;
                                 -fx-border-radius: 20;"/>
        </HBox>

        <!-- Volume -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Volume" style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px;"
                   minWidth="52"/>
            <Label text="0%" style="-fx-text-fill: #CCCCCC; -fx-font-size: 11px;"/>
            <Slider fx:id="volumeSlider" min="0" max="1" value="1"
                    style="-fx-accent: #FFFF00;"
                    maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Label text="100%" style="-fx-text-fill: #CCCCCC; -fx-font-size: 11px;"/>
        </HBox>

    </VBox>

    <Region prefHeight="16"/>

    <!-- Sleep timer card -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: #111111; -fx-background-radius: 14;
                 -fx-border-color: #FFFFFF; -fx-border-radius: 14; -fx-border-width: 1;">
        <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
        </padding>
        <Label text="Sleep timer" style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px;"/>
        <Spinner fx:id="sleepSpinner" prefWidth="66" editable="false"
                 style="-fx-font-size: 13px;">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="120" initialValue="15"/>
            </valueFactory>
        </Spinner>
        <Label text="min" style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px;"/>
        <Button fx:id="sleepToggleButton" text="Start"
                style="-fx-background-color: #1A1A1A; -fx-text-fill: #FFFFFF;
                       -fx-background-radius: 8; -fx-padding: 5 16;
                       -fx-font-size: 12px; -fx-cursor: hand;
                       -fx-border-color: #FFFFFF; -fx-border-width: 1;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="sleepCounterLabel" text=""
               style="-fx-text-fill: #FFFF00; -fx-font-size: 12px; -fx-font-weight: bold;"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>
</VBox>
